
"use strict";

const { randomUUID } = require("crypto");
const registry = require("./connectorRegistry");

const UUID =
    /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

const REQUEST_EVENT = "reconcile:observeExecution";
const RESULT_EVENT = "reconcile:observeExecutionResult";

function isUuid(value) {
    return typeof value === "string" && UUID.test(value);
}

function isOwnedSocket(socket, connectorId, expectedSocketId) {
    return Boolean(
        socket &&
        socket.connected === true &&
        socket.id === expectedSocketId &&
        registry.get(connectorId) === socket &&
        (
            socket.connectorIds?.has(connectorId) ||
            socket.connectorId === connectorId
        )
    );
}

/**
 * Read-only observation of an execution in the original
 * connector process.
 *
 * Never use this response alone as durable quiescence,
 * Redis cleanup proof, or settlement authorization.
 */
function sendManualReconcileExecutionObservationRequest({
    connectorId,
    expectedSocketId,
    attemptId,
    executionId,
    expectedProcessEpoch,
    expectedFenceId,
    timeoutMs = 10000
} = {}) {
    if (
        typeof connectorId !== "string" ||
        !connectorId.trim() ||
        typeof expectedSocketId !== "string" ||
        !expectedSocketId.trim() ||
        !isUuid(attemptId) ||
        !isUuid(executionId) ||
        !isUuid(expectedProcessEpoch) ||
        !isUuid(expectedFenceId) ||
        !Number.isSafeInteger(timeoutMs) ||
        timeoutMs < 1 ||
        timeoutMs > 60000
    ) {
        return Promise.reject(
            new Error("RECONCILE_OBSERVATION_ARGUMENTS_INVALID")
        );
    }

    const socket = registry.get(connectorId);

    if (!isOwnedSocket(socket, connectorId, expectedSocketId)) {
        return Promise.reject(
            new Error("RECONCILE_OBSERVATION_SOCKET_NOT_OWNED")
        );
    }

    const requestId = randomUUID();

    return new Promise((resolve, reject) => {
        let finished = false;
        let timer;

        function cleanup() {
            clearTimeout(timer);
            socket.off(RESULT_EVENT, onResult);
            socket.off("disconnect", onDisconnect);
        }

        function finish(error, result) {
            if (finished) return;

            finished = true;
            cleanup();

            if (error) reject(error);
            else resolve(result);
        }

        function onDisconnect() {
            finish(
                new Error("RECONCILE_OBSERVATION_SOCKET_DISCONNECTED")
            );
        }

        function onResult(data) {
            if (data?.requestId !== requestId) return;

            if (!isOwnedSocket(
                socket,
                connectorId,
                expectedSocketId
            )) {
                finish(
                    new Error("RECONCILE_OBSERVATION_SOCKET_OWNERSHIP_LOST")
                );
                return;
            }

            if (
                data.success !== true ||
                data.settlementEligible !== false
            ) {
                finish(
                    new Error("RECONCILE_OBSERVATION_RESPONSE_INVALID")
                );
                return;
            }

                      const o = data.observation;

            if (
                !o ||
                typeof o !== "object" ||
                Array.isArray(o) ||
                !isUuid(o.attemptId) ||
                !isUuid(o.executionId) ||
                !isUuid(o.processEpoch) ||
                !isUuid(o.fenceId) ||
                o.attemptId.toLowerCase() !== attemptId.toLowerCase() ||
                o.executionId.toLowerCase() !== executionId.toLowerCase() ||
                o.processEpoch.toLowerCase() !==
                    expectedProcessEpoch.toLowerCase() ||
                !Number.isSafeInteger(o.generation) ||
                o.generation < 0 ||
                o.fenced !== true ||
                o.fenceId.toLowerCase() !==
                    expectedFenceId.toLowerCase() ||
                o.executionKnown !== true ||
                !Number.isSafeInteger(o.pending) ||
                o.pending !== 0 ||
                !Number.isSafeInteger(o.running) ||
                o.running !== 0 ||
                !Number.isSafeInteger(o.settled) ||
                o.settled < 1 ||
                o.locallyDrained !== true ||
                o.settlementEligible !== false
            ) {
                finish(
                    new Error("RECONCILE_OBSERVATION_NOT_VERIFIED")
                );
                return;
            }

                      finish(null, {
                requestId,
                attemptId,
                executionId,
                connectorId,
                socketId: expectedSocketId,
                observation: {
                    attemptId: o.attemptId,
                    executionId: o.executionId,
                    processEpoch: o.processEpoch,
                    generation: o.generation,
                    fenced: true,
                    fenceId: o.fenceId,
                    executionKnown: true,
                    pending: 0,
                    running: 0,
                    settled: o.settled,
                    locallyDrained: true,
                    settlementEligible: false
                },
                settlementEligible: false
            });
        }

        socket.on(RESULT_EVENT, onResult);
        socket.once("disconnect", onDisconnect);

        timer = setTimeout(
            () => finish(
                new Error("RECONCILE_OBSERVATION_ACK_TIMEOUT")
            ),
            timeoutMs
        );

        if (!isOwnedSocket(
            socket,
            connectorId,
            expectedSocketId
        )) {
            finish(
                new Error("RECONCILE_OBSERVATION_SOCKET_OWNERSHIP_LOST")
            );
            return;
        }

        try {
            socket.emit(REQUEST_EVENT, {
                requestId,
                attemptId,
                executionId
            });
        } catch (_error) {
            finish(
                new Error("RECONCILE_OBSERVATION_EMIT_FAILED")
            );
        }
    });
}

module.exports = {
    sendManualReconcileExecutionObservationRequest
};
